# IntelliJ Run Configuration
# Active profiles: dev
# Working directory: identity-service 저장소 루트
#
# .env.dev 복사 이후 학교 개발 DB 접속값으로 변경
# 운영 DB와 운영 JWT private key의 개발 환경 사용 금지

SERVER_PORT=8083

# Frontend 프로세스와 Identity에 같은 개발용 HTTP Basic Credential을 주입
# openssl rand -hex 32로 생성한 난수를 Frontend와 동일하게 설정
FRONTEND_USERNAME=frontend
FRONTEND_PASSWORD=<replace-me>

# Learning과 Identity에 같은 개발용 계정 조회 Credential 주입
LEARNING_IDENTITY_USERNAME=learning-service
LEARNING_IDENTITY_PASSWORD=<replace-me>

# 학교 PostgreSQL의 개발용 DB 또는 schema에 접근하는 계정
DB_URL=jdbc:postgresql://<school-postgresql-host>:<port>/<development-database>
DB_USERNAME=<development-user>
DB_PASSWORD=<development-password>

# 개발용 Authentication Epoch Redis 접속 정보
AUTH_EPOCH_REDIS_HOST=<development-redis-host>
AUTH_EPOCH_REDIS_PORT=6379
AUTH_EPOCH_REDIS_DATABASE=0
AUTH_EPOCH_REDIS_USERNAME=<development-user>
AUTH_EPOCH_REDIS_PASSWORD=<development-password>
AUTH_EPOCH_REDIS_CONNECT_TIMEOUT=1s
AUTH_EPOCH_REDIS_COMMAND_TIMEOUT=2s
AUTH_EPOCH_REDIS_SSL_ENABLED=false

# 공유 DB의 Migration은 담당 절차에서만 실행
FLYWAY_ENABLED=false

# 로컬 인스턴스를 운영 Discovery에 등록하지 않음
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/

# 개발자별 로컬 RSA key pair 사용
JWT_ISSUER=https://identity.omagotchi.local
JWT_AUDIENCE=omagotchi-api
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt-public.pem
JWT_PRIVATE_KEY_LOCATION=file:./secrets/jwt-private.pem

# 최초 로그인 시점 기준 Refresh Token family의 고정 수명
REFRESH_TOKEN_TTL=P7D

# 연속 로그인 실패 잠금 정책
LOGIN_MAXIMUM_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=PT10M
