# IntelliJ Run Configuration
# Active profiles: local
# Working directory: identity-service 저장소 루트
#
# .env.local 복사 이후 로컬 실행 환경에 맞춘 값 변경

SERVER_PORT=8083

# Frontend 프로세스가 /api/v1/auth/**를 직접 호출할 때 사용하는 로컬 HTTP Basic Credential
# 공유 환경에서는 openssl rand -hex 32로 허용 문자 범위의 난수를 생성
FRONTEND_USERNAME=frontend
FRONTEND_PASSWORD=local-only-change-this-frontend-password

# Learning의 계정 조회 API 호출에만 사용하는 로컬 HTTP Basic Credential
LEARNING_IDENTITY_USERNAME=learning-service
LEARNING_IDENTITY_PASSWORD=local-only-change-this-learning-password

# 로컬 PostgreSQL 접속 정보
DB_URL=jdbc:postgresql://localhost:5432/identity_service
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 계정별 Authentication Epoch 저장용 Redis
AUTH_EPOCH_REDIS_HOST=localhost
AUTH_EPOCH_REDIS_PORT=6379
AUTH_EPOCH_REDIS_DATABASE=0
AUTH_EPOCH_REDIS_USERNAME=default
AUTH_EPOCH_REDIS_PASSWORD=test-only-authentication-epoch-password
AUTH_EPOCH_REDIS_CONNECT_TIMEOUT=1s
AUTH_EPOCH_REDIS_COMMAND_TIMEOUT=2s
AUTH_EPOCH_REDIS_SSL_ENABLED=false

# Discovery 동시 실행 시 명시적 활성화
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/

# Git에서 제외된 로컬 JWT RSA key 파일
JWT_ISSUER=https://identity.omagotchi.local
JWT_AUDIENCE=omagotchi-api
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt-public.pem
JWT_PRIVATE_KEY_LOCATION=file:./secrets/jwt-private.pem

# Refresh Token은 최초 로그인 시점부터 7일 동안만 유효하며 갱신해도 연장하지 않음
REFRESH_TOKEN_TTL=P7D

# 연속 로그인 실패 잠금 정책
LOGIN_MAXIMUM_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=PT10M
